{
  "name": "rlm-mcp-server",
  "version": "2.1.0",
  "description": "Recursive Language Model (RLM) MCP Server - Enable any LLM to process arbitrarily long contexts through recursive decomposition",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npx pm2 start prod.config.cjs",
    "dev": "tsx --inspect-brk src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "llm",
    "recursive-language-model",
    "rlm",
    "long-context",
    "ai",
    "context-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "pm2": "^6.0.14",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
